        "resourceType": "AccessPolicyV2",
        "id": "walter-white-read",
        "name": "Walter White read-only",
        "description": "Read-only access to Patient/walter-white's record, for a test patient user.",
        "engine": "rule-engine",
        "attribute": [
          {
            "attributeId": "target",
            "operation": {
              "type": "read",
              "path": {
                "language": "text/fhirpath",
                "expression": "%request.resource_type + '/' + %request.id"
              }
            }
          }
        ],
        "rule": [
          {
            "name": "seed-patient-only",
            "combineBehavior": "any",
            "rule": [
              {
                "name": "capabilities",
                "condition": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.type = 'capabilities'"
                  }
                }
              },
              {
                "name": "read-patient",
                "target": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.type = 'read'"
                  }
                },
                "condition": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.resource_type = 'Patient' and %request.id = 'walter-white'"
                  }
                }
              },
              {
                "name": "read-by-subject",
                "target": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.type = 'read' and %request.resource_type in ('Observation' | 'Condition' | 'MedicationRequest' | 'Encounter' | 'Procedure' | 'DocumentReference')"
                  }
                },
                "condition": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "'Patient/walter-white' in %target.subject.reference"
                  }
                }
              },
              {
                "name": "read-by-patient",
                "target": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.type = 'read' and %request.resource_type in ('AllergyIntolerance' | 'Immunization')"
                  }
                },
                "condition": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "'Patient/walter-white' in %target.patient.reference"
                  }
                }
              },
              {
                "name": "read-by-participant-actor",
                "target": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.type = 'read' and %request.resource_type in ('Appointment')"
                  }
                },
                "condition": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "'Patient/walter-white' in %target.participant.actor.reference"
                  }
                }
              },
              {
                "name": "read-shared",
                "target": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.type = 'read'"
                  }
                },
                "condition": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.resource_type in ('Medication')"
                  }
                }
              },
              {
                "name": "search-by-type",
                "target": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.type = 'search' and %request.resource_type.exists()"
                  }
                },
                "condition": {
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%request.resource_type in ('Patient' | 'Observation' | 'Condition' | 'MedicationRequest' | 'Encounter' | 'Procedure' | 'DocumentReference' | 'AllergyIntolerance' | 'Immunization' | 'Appointment')"
                  }
                }
              }
            ]
          }
        ]
      },
      "request": {
