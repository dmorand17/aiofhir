BASE=https://api.haste.health/w/livekit/synthea-sandbox/api/v1/fhir
# Admin seed login (an existing public client, see haste/bundles/create-seed-client.json)
CLIENT_ID=aiofhir-seed
# The patient login the seed invites and links to the seed Patient
SEED_USER_EMAIL=
# Optional: an existing tenant User id instead of SEED_USER_EMAIL
SEED_USER_ID=
# Optional: a token that can write /w/{tenant}/system/api/v1/fhir/User
SYSTEM_TOKEN=
# Written by the seed when it creates the smoke client
SMOKE_CLIENT_ID=aiofhir-smoke
SMOKE_CLIENT_SECRET=
